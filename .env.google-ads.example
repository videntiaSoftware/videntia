# Google Ads API Configuration
# Guía para obtener estas credenciales: https://developers.google.com/google-ads/api/docs/first-call/overview

# 1. Google Ads API credentials (obtener de Google Ads Developer Center)
GOOGLE_ADS_CLIENT_ID=tu_google_ads_client_id
GOOGLE_ADS_CLIENT_SECRET=tu_google_ads_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=tu_developer_token
GOOGLE_ADS_CUSTOMER_ID=tu_customer_id

# 2. OAuth2 credentials para acceso a cuenta
GOOGLE_ADS_REFRESH_TOKEN=tu_refresh_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=tu_login_customer_id

# 3. Configuración de campañas automáticas
AUTO_CAMPAIGN_MIN_USERS=10              # Mínimo usuarios para crear campaña
AUTO_CAMPAIGN_MAX_DAILY_BUDGET=100      # Máximo presupuesto diario por campaña
AUTO_CAMPAIGN_DEFAULT_BID=2.50          # Bid default para keywords premium

# 4. Umbrales de optimización
CAMPAIGN_MIN_CTR=0.005                  # CTR mínimo antes de pausar
CAMPAIGN_MAX_COST_PER_CONVERSION=10.00  # Costo máximo por conversión
CAMPAIGN_OPTIMIZATION_FREQUENCY=daily   # Frecuencia de optimización

# 5. Notificaciones
SLACK_WEBHOOK_CAMPAIGNS=tu_slack_webhook # Para notificar campañas creadas
EMAIL_ALERTS_ENABLED=true               # Alertas por email
