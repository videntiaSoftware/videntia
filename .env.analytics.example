# Google Analytics 4 Configuration
# Get this from: https://analytics.google.com/analytics/web/
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console Configuration
# Get these from: https://search.google.com/search-console/
NEXT_PUBLIC_GSC_VERIFICATION=your_google_verification_code
NEXT_PUBLIC_BING_VERIFICATION=your_bing_verification_code
NEXT_PUBLIC_YANDEX_VERIFICATION=your_yandex_verification_code

# Google Service Account for Search Console API
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Google Search Console API Configuration
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://your-domain.com

# PageSpeed Insights API (optional)
# Get from: https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=your_pagespeed_api_key

# Microsoft Clarity (optional alternative analytics)
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# Facebook Pixel (if using Facebook ads)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# Twitter/X Pixel (if using Twitter ads)
NEXT_PUBLIC_TWITTER_PIXEL_ID=your_twitter_pixel_id

# Hotjar (for user behavior analytics)
NEXT_PUBLIC_HOTJAR_ID=your_hotjar_id
NEXT_PUBLIC_HOTJAR_SV=your_hotjar_snippet_version

# Advanced SEO Configuration
SEO_ENABLE_AUTO_INDEXING=true
SEO_AUTO_SUBMIT_NEW_PAGES=true
SEO_MAX_URLS_PER_BATCH=10

# Content Optimization
CONTENT_AUTO_GENERATE_META=true
CONTENT_AUTO_OPTIMIZE_IMAGES=true
CONTENT_ENABLE_SCHEMA_VALIDATION=true
