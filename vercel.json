{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.videntiatarot.com" }],
      "destination": "https://videntiatarot.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "videntiatarot.com" },
        { "type": "header", "key": "x-forwarded-proto", "value": "http" }
      ],
      "destination": "https://videntiatarot.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/simple-daily-cards",
      "schedule": "0 10 * * *"
    }
  ]
}
